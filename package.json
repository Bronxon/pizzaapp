{
  "name": "pizzapp",
  "description": "Guía comunitaria para descubrir, calificar y ubicar pizzerías en Hermosillo, Sonora.",
  "version": "1.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"node open-browser.js\"",
    "mobile": "npx expo start",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis",
    "next:dev": "next dev --experimental-https",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@genkit-ai/google-genai": "^1.20.0",
    "@genkit-ai/next": "^1.20.0",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.0.0-rc.10",
    "@types/three": "^0.181.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "electron-updater": "6.8.9",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "expo": "^56.0.5",
    "genkit": "^1.20.0",
    "geolib": "^3.3.4",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.3.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.3.0",
    "patch-package": "^8.0.0",
    "prisma": "5.22.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.85.3",
    "react-native-webview": "^13.16.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.181.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "genkit-cli": "^1.20.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.pizzapp.app",
    "productName": "PizzApp",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "UnnamedUser0",
      "repo": "studio"
    },
    "extraMetadata": {
      "main": "electron-main.js",
      "dependencies": {}
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "electron-main.js",
      "update.html",
      "public/icon.png",
      "node_modules/**/*",
      "!node_modules/@prisma/**/*",
      "!node_modules/prisma/**/*",
      "!node_modules/@react-three/**/*",
      "!node_modules/three/**/*",
      "!node_modules/react-native/**/*",
      "!node_modules/hermes-compiler/**/*",
      "!node_modules/fb-dotslash/**/*",
      "!node_modules/next/**/*",
      "!node_modules/genkit/**/*",
      "!node_modules/@esbuild/**/*",
      "!node_modules/esbuild/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/@types/**/*",
      "!node_modules/maplibre-gl/**/*",
      "!node_modules/recharts/**/*",
      "!node_modules/tailwindcss/**/*",
      "!node_modules/postcss/**/*",
      "!node_modules/autoprefixer/**/*",
      "!node_modules/@google-genai/**/*",
      "!node_modules/@radix-ui/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
